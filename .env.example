# Product environment variables. Set these in the Vercel dashboard
# (Project → Settings → Environment Variables) — do NOT commit real values.

# Required
STRIPE_SECRET_KEY=        # Stripe secret key (sk_test_... to start, then sk_live_...)
ANTHROPIC_API_KEY=        # Anthropic API key (generates the paid report)

# Optional
PRO_PRICE_CENTS=9900      # price of the Pro report in cents (default $99.00)
PRO_CURRENCY=usd
WF_LLM_MODEL=claude-sonnet-5
