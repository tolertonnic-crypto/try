# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Claude API (script + metadata generation) ---
ANTHROPIC_API_KEY=

# --- YouTube Data API v3 / Analytics API ---
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console.
YT_CLIENT_SECRETS_FILE=client_secret.json
# Where the pipeline stores the OAuth token + refresh token after first auth.
YT_TOKEN_FILE=data/token.json

# --- Asset tool stubs (optional until you wire them) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PEXELS_API_KEY=
